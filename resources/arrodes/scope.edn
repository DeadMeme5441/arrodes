{:product "Arrodes"
 :version "0.1.0"
 :repository "https://github.com/DeadMeme5441/arrodes-mono"
 :runtime :jvm-clojure
 :baseline {:repository "https://github.com/earendil-works/pi"
            :revision "71dca871bc80b6bc97be37f0ca3189399d651fff"
            :compatibility :behavioral
            :typescript-extension-compatibility false}
 :domains {:durable-session [:identity :tree :branches :configuration :messages :operations :queues :events :results]
           :live-session [:provider-loop :capabilities :evaluator :cancellation :resources]
           :interfaces [:terminal :print :json-events :sdk :stdio-rpc]}
 :required
 [{:id :session-lifecycle :features [:create :open :list :resume :rename :labels :delete :ephemeral]}
  {:id :history :features [:append-only-tree :active-branch :prompt-edit :fork :clone :import :export :branch-summary]}
  {:id :durability :features [:atomic-commit :optimistic-revision :restart-recovery :no-effect-replay :private-storage]}
  {:id :execution :features [:prompt :continue :stream :tools :cancel :steer :follow-up :parallel-tools :ordered-results]}
  {:id :context :features [:projection :manual-compaction :automatic-compaction :overflow-recovery :retry
                          :stable-cache-prefix :provider-native-cache :honest-cache-usage]}
  {:id :providers :features [:catalog :api-key :oauth :model-selection :thinking :usage :cost :custom-provider]}
  {:id :capabilities :features [:one-registry :schemas :hooks :locks :progress :cancellation :provider-visibility]}
  {:id :coding :features [:read :write :edit :bash :powershell :grep :find :ls :images :bounded-output]}
  {:id :evaluator :features [:persistent-namespace :definitions :native-results :composition :explicit-registration :reset]}
  {:id :resources :features [:settings :project-trust :context-files :skills :prompts :extensions :reload]}
  {:id :packages :features [:install :list :configure :update :remove :pinned-references]}
  {:id :terminal :features [:multiline :completion :file-references :clipboard :external-editor :selectors :tree :themes :keybindings :extension-rendering]}
  {:id :programmatic :features [:embedding :print :json :rpc :host-requests :export :share]}]
 :excluded [:generalized-workspace :subagents :advisors :mcp :planning-mode :todo-manager
            :background-job-manager :distributed-runtime :replication :os-sandbox
            :jvm-checkpointing :legacy-arrodes-migration]
 :evaluator-lifetime {:preserved-on [:continue :model-change :compaction]
                      :reset-on [:branch-navigation :reload :close :restart]
                      :fork :fresh}
 :storage {:backend :sqlite :large-payloads :immutable-files :alternate-backends false}}
