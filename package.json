{
  "name": "arrodes",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "build": "clojure -Srepro -M:tui-build",
    "release": "bun scripts/build-release.ts",
    "test:tui": "bun scripts/test-tui.ts",
    "test:themes": "bun scripts/test-tui.ts arrodes.theme-ui-test",
    "tui": "bun scripts/tui.ts",
    "dev": "bun scripts/tui.ts",
    "test:core": "clojure -Srepro -M:test",
    "test:release": "bun test scripts/updater.test.ts scripts/release-payload.test.ts",
    "test": "bun run test:release && bun run test:core && bun run test:tui"
  },
  "dependencies": {
    "@opentui/core": "0.5.11",
    "web-tree-sitter": "0.25.10"
  }
}
