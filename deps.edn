{:paths ["modules/common/src" "modules/session/src" "modules/runtime/src" "modules/cli/src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
        org.slf4j/slf4j-nop {:mvn/version "2.0.17"}
        org.jline/jline {:mvn/version "3.30.17"}
        clj-commons/clj-yaml {:mvn/version "1.0.29"}
        com.deadmeme5441/clojure-llm-sdk
        {:git/url "https://github.com/DeadMeme5441/clojure-llm-sdk"
         :git/sha "5f9a51e50dbccdef062105b28d6ec4c77e5e411e"}}
 :aliases {:run {:main-opts ["-m" "arrodes.cli"]}
           :test {:extra-paths ["test"] :main-opts ["-m" "arrodes.test-runner"]}
           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
                   :ns-default build}}}
