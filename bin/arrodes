#!/bin/sh
set -eu
launch_cwd=$PWD
export ARRODES_LAUNCH_CWD="$launch_cwd"
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -f "$root/target/arrodes.jar" ]; then
  exec java -jar "$root/target/arrodes.jar" --cwd "$launch_cwd" "$@"
fi
if ! command -v clojure >/dev/null 2>&1; then
  printf '%s\n' 'Arrodes requires Java 21+ and Clojure CLI, or a built target/arrodes.jar.' >&2
  exit 127
fi
cd "$root"
exec clojure -Srepro -M:run --cwd "$launch_cwd" "$@"
